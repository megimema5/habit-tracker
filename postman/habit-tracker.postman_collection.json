                  "  pm.test('Covers 7 days', () => {",
                  "    pm.expect(data.days).to.eql(7);",
                  "    pm.expect(data.trend).to.have.lengthOf(7);",
                  "    pm.expect(data.to).to.eql(pm.collectionVariables.get('today'));",
                  "  });",
                  "  pm.test('Has a row per habit and per weekday', () => {",
                  "    pm.expect(data.perHabit).to.have.lengthOf(3);",
                  "    pm.expect(data.missedByWeekday).to.have.lengthOf(7);",
                  "  });",
                  "  pm.test('Yesterday counts as done for the daily habit', () => {",
                  "    const daily = data.perHabit.find((h) => h.habitId === Number(pm.collectionVariables.get('habitId')));",
                  "    pm.expect(daily.done).to.be.at.least(1);",
                  "  });",
                  "}"
                ]
              }
