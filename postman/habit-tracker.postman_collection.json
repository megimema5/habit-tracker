        {
          "name": "List habits",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/habits?today={{today}}&days=7",
              "host": ["{{baseUrl}}"],
              "path": ["habits"],
              "query": [
