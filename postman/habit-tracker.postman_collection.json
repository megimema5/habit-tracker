                  "key": "today",
                  "value": "{{today}}"
                },
                {
                  "key": "days",
                  "value": "7"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "  pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "  const { data } = pm.response.json();",
                  "  pm.test('Has the 3 habits created above', () => pm.expect(data).to.have.lengthOf(3));",
                  "  pm.test('Daily habit has streaks, others have weekly progress', () => {",
                  "    const daily = data.find((h) => h.scheduleType === 'daily');",
                  "    const weekly = data.find((h) => h.scheduleType === 'weekly');",
                  "    pm.expect(daily.currentStreak).to.be.a('number');",
                  "    pm.expect(daily.weekProgress).to.be.null;",
                  "    pm.expect(weekly.currentStreak).to.be.null;",
                  "    pm.expect(weekly.weekProgress).to.eql({ done: 0, target: 1 });",
                  "  });",
                  "}"
                ]
