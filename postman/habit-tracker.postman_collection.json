{
  "info": {
    "_postman_id": "edcafde4-6c55-4219-8577-c4ea464427ce",
    "name": "Habit Tracker API",
    "description": "Every endpoint of the Habit Tracker API with automatic checks.\n\n**How to use**\n1. Start the API: `npm run dev` (it listens on http://localhost:3001).\n2. Import this file in Postman (File → Import).\n3. Run the whole collection with the Collection Runner, or send requests one by one from top to bottom.\n\n**Notes**\n- Login uses an httpOnly cookie. Postman stores and sends it automatically after Register / Login.\n- `{{today}}`, `{{yesterday}}` and `{{futureDate}}` are calculated before every request.\n- Each run registers a new random user, so it can be repeated.\n- Login/register is rate-limited to 10 attempts per 15 minutes. One full run uses 5. If you get 429, restart the server (the limit is kept in memory) or wait.\n- Demo account (after `npm run seed`): demo@example.com / demo1234.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001/api"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": "password123"
    },
    {
      "key": "today",
      "value": ""
    },
    {
      "key": "yesterday",
      "value": ""
    },
    {
      "key": "futureDate",
      "value": ""
    },
    {
      "key": "habitId",
      "value": ""
    },
