      "key": "weeklyHabitId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Local dates as YYYY-MM-DD (the API expects the client's local date).",
          "const pad = (n) => String(n).padStart(2, '0');",
          "const fmt = (d) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;",
          "const shift = (days) => { const d = new Date(); d.setDate(d.getDate() + days); return fmt(d); };",
          "pm.collectionVariables.set('today', shift(0));",
          "pm.collectionVariables.set('yesterday', shift(-1));",
          "pm.collectionVariables.set('futureDate', shift(5));"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Every response must be JSON in our format (except 204 No Content).",
          "if (pm.response.code !== 204) {",
          "  pm.test('Response is JSON with data or error', () => {",
          "    const body = pm.response.json();",
          "    pm.expect(body).to.satisfy((b) => 'data' in b || 'error' in b);",
          "  });",
          "}"
        ]
      }
    }
  ],
