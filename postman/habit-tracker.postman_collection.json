              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('email', `user_${Date.now()}@example.com`);"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "  pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "  pm.test('Returns the user without any password field', () => {",
                  "    const { data } = pm.response.json();",
                  "    pm.expect(data.email).to.eql(pm.collectionVariables.get('email'));",
                  "    pm.expect(JSON.stringify(data).toLowerCase()).to.not.include('password');",
                  "  });",
                  "  pm.test('Sets an httpOnly login cookie', () => {",
                  "    const cookie = pm.response.headers.get('Set-Cookie') || '';",
                  "    pm.expect(cookie).to.include('habit_token=');",
                  "    pm.expect(cookie.toLowerCase()).to.include('httponly');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
