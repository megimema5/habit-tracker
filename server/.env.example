# Copy this file to .env and fill in real values. Never commit .env.

# development | production | test
NODE_ENV=development

# Port the API listens on (the Vite dev server proxies /api to it)
PORT=3001

# SQLite database file (use :memory: for a throwaway in-memory DB)
DB_PATH=./data/habits.db

# Secret used to sign login tokens. Must be at least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login lasts (e.g. 30m, 12h, 7d)
JWT_EXPIRES_IN=7d

# bcrypt cost factor for password hashing (higher = slower = harder to crack)
BCRYPT_ROUNDS=12

# Where the React app runs (used for CORS / origin checks in production)
CLIENT_ORIGIN=http://localhost:5173

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
